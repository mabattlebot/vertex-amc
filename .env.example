# Copy to .env (never commit it) or set these in your host's environment settings.
# Keys starting with AQ. (Vertex AI Express) or AIza (Google AI Studio) are both supported and auto-detected.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
# Optional: override the endpoint base URL. Leave unset for auto-detection.
# Setting it disables Vertex AI Express (AQ.) auto-detection.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional backup provider. Used only if GEMINI_API_KEY is unset, or if a Gemini call
# itself fails (quota, outage, bad key). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000
